<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen window background: solid teal with the app icon centered.
  Displayed the instant the activity window appears, before Compose draws.
  Once Compose renders, the `LoadingContent` (logo + spinner) takes over
  until the data is ready, creating a seamless branded startup.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/splash_icon" />
</layer-list>
